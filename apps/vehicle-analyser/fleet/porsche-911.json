 "procedures": [
  {
   "title": "Walk-round inspection",
   "steps": [
    {
     "text": "Front: bonnet shut line even both sides, lamps clear and matching, bumper paint matching the wings.",
     "view": "front",
     "parts": [
      "bonnet"
     ],
     "open": []
    },
    {
     "text": "Front left corner: tyre tread and wear across the width, wheel for kerbing, arch for rust.",
     "view": "wheel:fl",
     "parts": [
      "wheel_fl"
     ],
     "open": []
    },
    {
     "text": "Left side: door gaps even, paint matching panel to panel, sills straight. Look along the side for ripples.",
     "view": "nearside",
     "parts": [
      "door_fl"
     ],
     "open": []
    },
    {
     "text": "Rear left corner: tyre and wheel as at the front; the arch lip.",
     "view": "wheel:rl",
     "parts": [
      "wheel_rl"
     ],
     "open": []
    },
    {
     "text": "Rear: tailgate shut lines, lamps, bumper. A boot that does not close flush has been hit.",
     "view": "rear",
     "parts": [
      "tailgate"
     ],
     "open": []
    },
    {
     "text": "Rear right corner.",
     "view": "wheel:rr",
     "parts": [
      "wheel_rr"
     ],
     "open": []
    },
    {
     "text": "Right side: the same as the left, and the fuel filler area.",
     "view": "offside",
     "parts": [
      "door_fr"
     ],
     "open": []
    },
    {
     "text": "Front right corner.",
     "view": "wheel:fr",
     "parts": [
      "wheel_fr"
     ],
     "open": []
    }
   ]
  },
  {
   "title": "Under the engine lid",
   "steps": [
    {
     "text": "Open the engine lid. Look for fresh paint on the panel edges and bolt heads: a sign of rear-end repair.",
     "view": "bay",
     "parts": [
      "tailgate"
     ],
     "open": [
      "tailgate"
     ]
    },
    {
     "text": "Battery: terminals clean, clamp tight, no white deposits.",
     "view": "part",
     "parts": [
      "bay:battery-assembly"
     ],
     "open": [
      "tailgate"
     ]
    },
    {
     "text": "Coolant tank: level between the marks, no oil film on the coolant.",
     "view": "part",
     "parts": [
      "bay:coolant-expansion-reservoir"
     ],
     "open": [
      "tailgate"
     ]
    },
    {
     "text": "Oil filler and cam cover: no mayonnaise under the cap, no oil weeping from the cover gasket.",
     "view": "part",
     "parts": [
      "bay:dgea_filler",
      "bay:cam_cover"
     ],
     "open": [
      "tailgate"
     ]
    },
    {
     "text": "Air box and intake: clips in place, no split ducting.",
     "view": "part",
     "parts": [
      "bay:dgea_airbox",
      "bay:dgea_intake"
     ],
     "open": [
      "tailgate"
     ]
    },
    {
     "text": "Belt and pulley: belt not glazed or cracked.",
     "view": "part",
     "parts": [
      "bay:dgea_pulley"
     ],
     "open": [
      "tailgate"
     ]
    },
    {
     "text": "Engine mount and wiring loom: mount rubber whole, loom tidy and clipped.",
     "view": "part",
     "parts": [
      "bay:dgea_mount",
      "bay:dgea_loom"
     ],
     "open": [
      "tailgate"
     ]
    }
   ]
  },
  {
   "title": "Doors and cabin",
   "steps": [
    {
