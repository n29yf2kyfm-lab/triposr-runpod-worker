 "procedures": [
  {
   "title": "Walk-round inspection",
   "steps": [
    {
     "text": "Front: bonnet shut line even both sides, lamps clear and matching, bumper paint matching the wings.",
     "view": "front",
     "parts": [
      "bonnet"
     ],
     "open": []
    },
    {
     "text": "Front left corner: tyre tread and wear across the width, wheel for kerbing, arch for rust.",
     "view": "wheel:fl",
     "parts": [
      "wheel_fl"
     ],
     "open": []
    },
    {
     "text": "Left side: door gaps even, paint matching panel to panel, sills straight. Look along the side for ripples.",
     "view": "nearside",
     "parts": [
      "door_fl",
      "door_rl"
     ],
     "open": []
    },
    {
     "text": "Rear left corner: tyre and wheel as at the front; the arch lip.",
     "view": "wheel:rl",
     "parts": [
      "wheel_rl"
     ],
     "open": []
    },
    {
     "text": "Rear: tailgate shut lines, lamps, bumper. A boot that does not close flush has been hit.",
     "view": "rear",
     "parts": [
      "tailgate"
     ],
     "open": []
    },
    {
     "text": "Rear right corner.",
     "view": "wheel:rr",
     "parts": [
      "wheel_rr"
     ],
     "open": []
    },
    {
     "text": "Right side: the same as the left, and the charge port flap.",
     "view": "offside",
     "parts": [
      "door_fr",
      "door_rr"
     ],
     "open": []
    },
    {
     "text": "Front right corner.",
     "view": "wheel:fr",
     "parts": [
      "wheel_fr"
     ],
     "open": []
    }
   ]
  },
  {
   "title": "Electric car checks",
   "steps": [
    {
     "text": "Front lid: open it. Under it is a front boot or a service area: dry, no ripples in the floor, the washer and coolant fillers where the car has them.",
     "view": "bay",
     "parts": [
      "bonnet"
     ],
     "open": [
      "bonnet"
     ]
    },
    {
     "text": "Charge port: find its flap (on a wing or a rear quarter). It opens and shuts cleanly; the socket's pins are straight and clean, with no scorch marks.",
     "view": "nearside",
     "parts": [],
     "open": []
    },
    {
     "text": "Underneath: the battery pack runs the length of the floor. Its casing free of scrapes, dents and cracks: it is the car's most costly part.",
     "view": "under",
     "parts": [],
     "open": []
    },
    {
     "text": "Tyres: an electric car is heavy and pulls hard from rest, so tyres wear faster. Tread across the whole width on all four.",
     "view": "wheel:fl",
     "parts": [
      "wheel_fl",
      "wheel_fr",
      "wheel_rl",
      "wheel_rr"
     ],
     "open": []
    }
   ]
  },
  {
   "title": "Doors and cabin",
   "steps": [
    {
     "text": "Open the front left door: hinges and check strap, door card fit, window operation.",
     "view": "door:fl",
     "parts": [
      "door_fl"
     ],
     "open": [
      "door_fl"
     ]
    },
    {
     "text": "Open the front right door: hinges and check strap, door card fit, window operation.",
     "view": "door:fr",
     "parts": [
      "door_fr"
     ],
     "open": [
      "door_fr"
     ]
    },
    {
     "text": "Open the sliding door, left: it runs smoothly on its rollers and track, holds open on its catch, and shuts flush and latches; seals whole.",
     "view": "door:rl",
     "parts": [
      "door_rl"
     ],
     "open": [
      "door_rl"
     ]
    },
    {
     "text": "Open the sliding door, right: it runs smoothly on its rollers and track, holds open on its catch, and shuts flush and latches; seals whole.",
     "view": "door:rr",
     "parts": [
      "door_rr"
     ],
     "open": [
      "door_rr"
     ]
    }
   ]
  }
