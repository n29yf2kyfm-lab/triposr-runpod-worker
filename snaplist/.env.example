# Copy to  api/.env  and fill in the keys you have. Every one is OPTIONAL —
# missing keys just fall back to realistic demo data, so the app runs as-is.

# --- AI: photo identification + listing copy (Anthropic) ---
# Get one at https://console.anthropic.com/  -> API keys
ANTHROPIC_API_KEY=
# The app's model choice (change freely):
ANTHROPIC_MODEL=claude-sonnet-5

# --- Market pricing / visual match (SerpApi Google Shopping/Lens) ---
# https://serpapi.com/  (free tier = 100 searches/mo)
SERPAPI_KEY=

# --- Promo video render ---
# VIDEO_PROVIDER=mock keeps storyboard-only output (no key needed).
# Set VIDEO_PROVIDER=creatify + VIDEO_API_KEY to render real clips.
VIDEO_PROVIDER=mock
VIDEO_API_KEY=

# --- eBay (Sandbox first — nothing goes live, no fees) ---
# Register at https://developer.ebay.com/  -> create a keyset.
# EBAY_USER_TOKEN is a user OAuth token authorising listing on the seller account.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_USER_TOKEN=
# Inventory location key. The app creates it for you on first publish if missing.
EBAY_LOCATION_KEY=snaplist-default

# eBay fetches listing images over the internet, so it cannot see localhost.
# In dev, expose the API with a tunnel (e.g. `ngrok http 8000`) and put the
# public https URL here. Without it, publishing has no usable image.
PUBLIC_BASE_URL=

# Where the web app is served from (dev default shown):
CORS_ORIGINS=http://localhost:5173
