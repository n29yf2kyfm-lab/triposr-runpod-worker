# Copy to  api/.env  and fill in the keys you have. Every one is OPTIONAL —
# missing keys just fall back to realistic demo data, so the app runs as-is.

# --- AI: photo identification + listing copy (Anthropic) ---
# Get one at https://console.anthropic.com/  -> API keys
ANTHROPIC_API_KEY=
# The app's model choice (change freely):
ANTHROPIC_MODEL=claude-sonnet-5

# --- Market pricing / visual match (SerpApi Google Shopping/Lens) ---
# https://serpapi.com/  (free tier = 100 searches/mo)
SERPAPI_KEY=

# --- Promo video render ---
# VIDEO_PROVIDER=mock keeps storyboard-only output (no key needed).
# Set VIDEO_PROVIDER=creatify + VIDEO_API_KEY to render real clips.
VIDEO_PROVIDER=mock
VIDEO_API_KEY=

# --- eBay (Sandbox first — nothing goes live, no fees) ---
# Register at https://developer.ebay.com/  -> create a keyset.
# EBAY_USER_TOKEN is a user OAuth token authorising listing on the seller account.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_USER_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US

# Inventory location — every offer must reference one. The app creates it on
# first publish if it doesn't exist; these are the address it uses.
EBAY_LOCATION_KEY=snaplist-default
EBAY_LOCATION_POSTAL_CODE=94105
EBAY_LOCATION_COUNTRY=US

# Business policies are REQUIRED to publish — eBay does not fall back to
# account defaults. Leave blank to auto-use your first policy of each kind
# (you must still be opted into Business Policies in eBay Seller Hub).
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# eBay's category-suggestion API does NOT work in Sandbox (it returns
# boilerplate), so Sandbox testing needs a category to fall back on.
# 112529 = Consumer Electronics > Headphones. Production resolves this itself.
EBAY_FALLBACK_CATEGORY_ID=112529

# Optional. Photos are uploaded straight to eBay's image hosting, so you
# normally don't need this. It's only a fallback if that upload is unavailable
# (e.g. in Sandbox): eBay fetches self-hosted images over the internet and
# cannot see localhost, so this must be a public https URL — in dev, a tunnel
# such as `ngrok http 8000`.
PUBLIC_BASE_URL=

# Where the web app is served from (dev default shown):
CORS_ORIGINS=http://localhost:5173
