# publish_batch appends every network action here as it runs. It is a run
# log, not source: it changes on every batch, conflicts on every merge, and
# says nothing a commit message does not. The catalogue and the manifests are
# the durable record.
pipeline/publish/publish_jobs.jsonl
pipeline/trellis/donor_wheel.glb

# Agent working directories. Session scratch lives outside the repo at
# /tmp/claude-0/<project>/<session>/scratchpad/ ; anything an agent drops here
# is working state, not source, and must not be committed.
scratchpad/
graphify-out/
