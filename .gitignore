node_modules/
pipeline/node_modules/
__pycache__/
*.pyc
.firecrawl/

# publish_batch appends every network action here as it runs. It is a run
# log, not source: it changes on every batch, conflicts on every merge, and
# says nothing a commit message does not. The catalogue and the manifests are
# the durable record.
pipeline/publish/publish_jobs.jsonl
pipeline/trellis/donor_wheel.glb

# Agent working directories. Session scratch lives outside the repo at
# /tmp/claude-0/<project>/<session>/scratchpad/ ; anything an agent drops here
# is working state, not source, and must not be committed.
scratchpad/
graphify-out/

# Car assets belong in the car-meshes bucket, never in git. They land here by
# accident when a `cd` into a scratch dir fails after a container rollback and
# curl writes into the repo root instead -- which happened twice on 2026-08-25.
# They are large binaries that are always re-downloadable from Supabase.
*.glb
*.gltf
# ...except the small component-library meshes, which ARE source.
!pipeline/components/*.glb

# machine-local: headroom writes ANTHROPIC_BASE_URL here. Committing it would
# point every fresh remote session at a proxy that is not running there.
.claude/settings.local.json
